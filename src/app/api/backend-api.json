{
  "openapi": "3.1.0",
  "info": { "title": "CSSS Site Backend", "version": "0.1.0" },
  "paths": {
    "/event": {
      "get": {
        "tags": ["event"],
        "summary": "Get All Events",
        "description": "Get all events",
        "operationId": "get_all_events",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Event" },
                  "title": "Response Get All Events"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["event"],
        "summary": "Create Event",
        "description": "Create a new event",
        "operationId": "create_event",
        "parameters": [
          {
            "name": "session_id",
            "in": "cookie",
            "required": false,
            "schema": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Session Id" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/EventCreate" } }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Event" } }
            }
          },
          "500": {
            "description": "failed to fetch new event",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/DetailModel" } }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "/event/{year}": {
      "get": {
        "tags": ["event"],
        "summary": "Get Events For This Year",
        "description": "Get events that start OR end in this year",
        "operationId": "get_events_for_this_year",
        "parameters": [
          {
            "name": "year",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "title": "Year" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Event" },
                  "title": "Response Get Events For This Year"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "/event/{year}/{month}": {
      "get": {
        "tags": ["event"],
        "summary": "Get Events For This Year Month",
        "description": "Get events that start OR end in the given year and month",
        "operationId": "get_events_for_this_year_month",
        "parameters": [
          {
            "name": "year",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "title": "Year" }
          },
          {
            "name": "month",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "title": "Month" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Event" },
                  "title": "Response Get Events For This Year Month"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "/event/{eid}": {
      "patch": {
        "tags": ["event"],
        "summary": "Update Event",
        "description": "Update an Event detail",
        "operationId": "update_event",
        "parameters": [
          {
            "name": "eid",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "title": "Eid" }
          },
          {
            "name": "session_id",
            "in": "cookie",
            "required": false,
            "schema": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Session Id" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/EventUpdate" } }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Event" } }
            }
          },
          "404": { "description": "Event doesn't exist." },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["event"],
        "summary": "Delete Event",
        "description": "Delete an event",
        "operationId": "delete_event",
        "parameters": [
          {
            "name": "eid",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "title": "Eid" }
          },
          {
            "name": "session_id",
            "in": "cookie",
            "required": false,
            "schema": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Session Id" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/EventDelete" } }
            }
          },
          "404": { "description": "Event doesn't exist." },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "/translink/realtime": {
      "get": {
        "tags": ["translink"],
        "summary": "Get Realtime Schedule",
        "description": "Get the realtime TransLink bus status.",
        "operationId": "get_realtime_schedule",
        "responses": {
          "200": {
            "description": "Realtime information for bus status",
            "content": {
              "application/json": {
                "schema": {
                  "items": { "$ref": "#/components/schemas/TransLinkRealtimeResponse" },
                  "type": "array",
                  "title": "Response Get Realtime Schedule"
                }
              }
            }
          }
        }
      }
    },
    "/translink/static": {
      "get": {
        "tags": ["translink"],
        "summary": "Get Static Schedule",
        "description": "Get the static TransLink departure schedule.",
        "operationId": "get_static_schedule",
        "responses": {
          "200": {
            "description": "The static departure schedule for the buses at the upper bus loop.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TransLinkStaticResponse" }
              }
            }
          }
        }
      }
    },
    "/translink/schedule": {
      "get": {
        "tags": ["translink"],
        "summary": "Get Departure Schedule",
        "description": "Get the departure schedule with bus status. Attempts to use the cached static schedule first.",
        "operationId": "get_departure_schedule",
        "responses": {
          "200": {
            "description": "The next three depature times with bus status information.",
            "content": {
              "application/json": {
                "schema": {
                  "items": { "$ref": "#/components/schemas/TransLinkScheduleResponse" },
                  "type": "array",
                  "title": "Response Get Departure Schedule"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Read Root",
        "operationId": "read_root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": { "application/json": { "schema": {} } }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BusStatus": { "type": "integer", "enum": [1, 2, 3, 4], "title": "BusStatus" },
      "Candidate": {
        "properties": {
          "computing_id": { "type": "string", "title": "Computing Id" },
          "nominee_election": { "type": "string", "title": "Nominee Election" },
          "position": { "$ref": "#/components/schemas/OfficerPositionEnum" },
          "speech": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Speech" }
        },
        "type": "object",
        "required": ["computing_id", "nominee_election", "position"],
        "title": "Candidate"
      },
      "CandidateCreate": {
        "properties": {
          "computing_id": { "type": "string", "title": "Computing Id" },
          "position": { "$ref": "#/components/schemas/OfficerPositionEnum" },
          "speech": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Speech" }
        },
        "type": "object",
        "required": ["computing_id", "position"],
        "title": "CandidateCreate"
      },
      "CandidateUpdate": {
        "properties": {
          "position": {
            "anyOf": [{ "$ref": "#/components/schemas/OfficerPositionEnum" }, { "type": "null" }]
          },
          "speech": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Speech" }
        },
        "type": "object",
        "title": "CandidateUpdate"
      },
      "DetailModel": {
        "properties": { "detail": { "type": "string", "title": "Detail" } },
        "type": "object",
        "required": ["detail"],
        "title": "DetailModel"
      },
      "ElectionParams": {
        "properties": {
          "name": { "type": "string", "title": "Name" },
          "type": { "$ref": "#/components/schemas/ElectionTypeEnum" },
          "datetime_start_nominations": {
            "type": "string",
            "format": "date-time",
            "title": "Datetime Start Nominations"
          },
          "datetime_start_voting": {
            "type": "string",
            "format": "date-time",
            "title": "Datetime Start Voting"
          },
          "datetime_end_voting": {
            "type": "string",
            "format": "date-time",
            "title": "Datetime End Voting"
          },
          "available_positions": {
            "anyOf": [
              { "items": { "$ref": "#/components/schemas/OfficerPositionEnum" }, "type": "array" },
              { "type": "null" }
            ],
            "title": "Available Positions"
          },
          "survey_link": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Survey Link"
          }
        },
        "type": "object",
        "required": [
          "name",
          "type",
          "datetime_start_nominations",
          "datetime_start_voting",
          "datetime_end_voting"
        ],
        "title": "ElectionParams"
      },
      "Event": {
        "properties": {
          "name": { "type": "string", "title": "Name" },
          "start_time": { "type": "string", "format": "date-time", "title": "Start Time" },
          "end_time": { "type": "string", "format": "date-time", "title": "End Time" },
          "description": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Description"
          },
          "frequency": {
            "anyOf": [{ "$ref": "#/components/schemas/EventFrequencyEnum" }, { "type": "null" }]
          },
          "repeat_start_date": {
            "anyOf": [{ "type": "string", "format": "date" }, { "type": "null" }],
            "title": "Repeat Start Date"
          },
          "repeat_end_date": {
            "anyOf": [{ "type": "string", "format": "date" }, { "type": "null" }],
            "title": "Repeat End Date"
          },
          "eid": { "type": "integer", "title": "Eid" }
        },
        "type": "object",
        "required": ["name", "start_time", "end_time", "eid"],
        "title": "Event"
      },
      "EventCreate": {
        "properties": {
          "name": { "type": "string", "title": "Name" },
          "start_time": { "type": "string", "format": "date-time", "title": "Start Time" },
          "end_time": { "type": "string", "format": "date-time", "title": "End Time" },
          "description": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Description"
          },
          "frequency": {
            "anyOf": [{ "$ref": "#/components/schemas/EventFrequencyEnum" }, { "type": "null" }]
          },
          "repeat_start_date": {
            "anyOf": [{ "type": "string", "format": "date" }, { "type": "null" }],
            "title": "Repeat Start Date"
          },
          "repeat_end_date": {
            "anyOf": [{ "type": "string", "format": "date" }, { "type": "null" }],
            "title": "Repeat End Date"
          }
        },
        "type": "object",
        "required": ["name", "start_time", "end_time"],
        "title": "EventCreate"
      },
      "EventDelete": {
        "properties": {
          "result": { "type": "boolean", "title": "Result" },
          "eid": { "type": "integer", "title": "Eid" }
        },
        "type": "object",
        "required": ["result", "eid"],
        "title": "EventDelete"
      },
      "EventFrequencyEnum": {
        "type": "string",
        "enum": ["NONE", "DAILY", "WEEKLY", "MONTHLY", "SEMESTERLY", "YEARLY"],
        "title": "EventFrequencyEnum"
      },
      "EventUpdate": {
        "properties": {
          "name": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Name" },
          "start_time": {
            "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }],
            "title": "Start Time"
          },
          "end_time": {
            "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }],
            "title": "End Time"
          },
          "description": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Description"
          },
          "frequency": {
            "anyOf": [{ "$ref": "#/components/schemas/EventFrequencyEnum" }, { "type": "null" }]
          },
          "repeat_start_date": {
            "anyOf": [{ "type": "string", "format": "date" }, { "type": "null" }],
            "title": "Repeat Start Date"
          },
          "repeat_end_date": {
            "anyOf": [{ "type": "string", "format": "date" }, { "type": "null" }],
            "title": "Repeat End Date"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "EventUpdate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": { "$ref": "#/components/schemas/ValidationError" },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SuccessResponse": {
        "properties": { "success": { "type": "boolean", "title": "Success" } },
        "type": "object",
        "required": ["success"],
        "title": "SuccessResponse"
      },
      "TransLinkRealtimeResponse": {
        "properties": {
          "route_number": {
            "type": "string",
            "title": "Route Number",
            "description": "The bus route number."
          },
          "scheduled_departure_time": {
            "type": "integer",
            "title": "Scheduled Departure Time",
            "description": "Unix timestamp for the scheduled departure time, in seconds."
          },
          "realtime_time": {
            "type": "integer",
            "title": "Realtime Time",
            "description": "Unix timestamp for the buses actual arrival time, in seconds."
          },
          "delay_seconds": {
            "type": "integer",
            "title": "Delay Seconds",
            "description": "How delayed the bus is, in seconds. Positive numbers indicate the bus is late, negative is early."
          }
        },
        "type": "object",
        "required": ["route_number", "scheduled_departure_time", "realtime_time", "delay_seconds"],
        "title": "TransLinkRealtimeResponse"
      },
      "TransLinkScheduleResponse": {
        "properties": {
          "route_number": {
            "type": "string",
            "title": "Route Number",
            "description": "The bus route number."
          },
          "scheduled_departure_time": {
            "type": "integer",
            "title": "Scheduled Departure Time",
            "description": "Unix timestamp for the scheduled departure time, in seconds."
          },
          "realtime_time": {
            "type": "integer",
            "title": "Realtime Time",
            "description": "Unix timestamp for the buses actual arrival time, in seconds."
          },
          "delay_seconds": {
            "type": "integer",
            "title": "Delay Seconds",
            "description": "How delayed the bus is, in seconds. Positive numbers indicate the bus is late, negative is early."
          },
          "status": {
            "$ref": "#/components/schemas/BusStatus",
            "description": "Enum that indicates if the bus has arrived (1), is delayed (2), is on time (3), or cancelled (4)."
          }
        },
        "type": "object",
        "required": [
          "route_number",
          "scheduled_departure_time",
          "realtime_time",
          "delay_seconds",
          "status"
        ],
        "title": "TransLinkScheduleResponse"
      },
      "TransLinkStaticResponse": {
        "properties": {
          "date_fetched": {
            "type": "string",
            "format": "date",
            "title": "Date Fetched",
            "description": "The date derived from the app's TZ_INFO (most likely America/Vancouver)"
          },
          "schedule": {
            "items": { "$ref": "#/components/schemas/TransLinkStaticScheduleEntry" },
            "type": "array",
            "title": "Schedule",
            "description": "The static departure schedule for the buses at the upper bus loop."
          }
        },
        "type": "object",
        "required": ["date_fetched", "schedule"],
        "title": "TransLinkStaticResponse"
      },
      "TransLinkStaticScheduleEntry": {
        "properties": {
          "trip_id": {
            "type": "string",
            "title": "Trip Id",
            "description": "The GTFS Trip ID for this bus."
          },
          "route_id": {
            "type": "string",
            "title": "Route Id",
            "description": "The GTFS Route ID for this bus."
          },
          "bus_number": {
            "type": "string",
            "title": "Bus Number",
            "description": "The bus route number."
          },
          "departure_seconds": {
            "type": "integer",
            "title": "Departure Seconds",
            "description": "The number of seconds after midnight for this departure."
          },
          "departure_time": {
            "type": "string",
            "title": "Departure Time",
            "description": "Time that the bus is departing as a HH:MM:SS string."
          }
        },
        "type": "object",
        "required": ["trip_id", "route_id", "bus_number", "departure_seconds", "departure_time"],
        "title": "TransLinkStaticScheduleEntry"
      },
      "UpdateUserParams": {
        "properties": {
          "profile_picture_url": { "type": "string", "title": "Profile Picture Url" }
        },
        "type": "object",
        "required": ["profile_picture_url"],
        "title": "UpdateUserParams"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": { "anyOf": [{ "type": "string" }, { "type": "integer" }] },
            "type": "array",
            "title": "Location"
          },
          "msg": { "type": "string", "title": "Message" },
          "type": { "type": "string", "title": "Error Type" },
          "input": { "title": "Input" },
          "ctx": { "type": "object", "title": "Context" }
        },
        "type": "object",
        "required": ["loc", "msg", "type"],
        "title": "ValidationError"
      }
    }
  },
  "servers": [{ "url": "/api" }]
}
