{
  "name": "csss-site-kiosk",
  "version": "0.0.5",
  "private": true,
  "workspaces": [
    "frontend",
    "server"
  ],
  "scripts": {
    "ng": "npm run ng --workspace frontend --",
    "api:url": "npm run api:url --workspace frontend",
    "api:file": "npm run api:file --workspace frontend",
    "start": "npm run build && npm run start:server",
    "build": "npm run build --workspace frontend",
    "watch": "npm run watch --workspace frontend --",
    "test": "npm run test --workspace frontend --",
    "lint": "npm run lint --workspace frontend --",
    "format": "npm run format --workspace frontend --",
    "precommit": "npm run lint && npm run format",
    "start:frontend": "npm run start --workspace frontend --",
    "start:server": "npm run start --workspace server --",
    "dev:build": "npm run dev:build --workspace frontend --",
    "dev:server": "npm run start:server",
    "dev": "concurrently --kill-others-on-fail \"npm run dev:build\" \"npm run dev:server\"",
    "start:kiosk": "npm start"
  },
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/router": "^22.1.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "allowScripts": {
    "@openapitools/openapi-generator-cli@2.40.1": true,
    "@parcel/watcher@2.5.6": true,
    "@scarf/scarf": false,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
